<div class="max-w-7xl mx-auto px-6 py-32">
  <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
    <div>
      <span class="text-purple-500 font-bold uppercase tracking-widest text-sm mb-4 block">{{ section.settings.subheading }}</span>
      <h2 class="text-5xl md:text-6xl">{{ section.settings.heading }}</h2>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
    {% for product in section.settings.collection.products limit: 4 %}
      <div class="glass-card overflow-hidden group">
        <div class="relative aspect-[4/5] overflow-hidden">
          <img src="{{ product.featured_image | img_url: '800x' }}" alt="{{ product.title }}" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110">
          <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
            <form action="/cart/add" method="post">
              <input type="hidden" name="id" value="{{ product.variants.first.id }}">
              <button type="submit" class="bg-white text-black font-bold px-6 py-3 rounded-full">Add to Cart</button>
            </form>
          </div>
        </div>
        <div class="p-6">
          <h3 class="text-lg font-bold mb-2">{{ product.title }}</h3>
          <p class="text-xl font-bold text-white/90">{{ product.price | money }}</p>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Featured Drops",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Shop the Hype" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured Drops" },
    { "type": "collection", "id": "collection", "label": "Collection" }
  ],
  "presets": [{ "name": "Featured Drops" }]
}
{% endschema %}
