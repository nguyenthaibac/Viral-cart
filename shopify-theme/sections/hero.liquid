<section class="relative h-screen flex items-center justify-center overflow-hidden pt-20">
  <div class="absolute inset-0 z-0">
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-purple-500/20 blur-[120px] rounded-full"></div>
    <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-cyan-500/20 blur-[120px] rounded-full"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-6 text-center">
    <span class="inline-block bg-white/10 border border-white/20 text-cyan-400 text-xs font-bold uppercase tracking-[0.3em] px-4 py-2 rounded-full mb-6">
      {{ section.settings.subheading }}
    </span>
    <h1 class="text-6xl md:text-8xl lg:text-9xl font-black tracking-tighter mb-8 leading-[0.9] italic uppercase">
      {{ section.settings.heading_part_1 }} <span class="text-purple-500 italic">{{ section.settings.heading_accent }}</span> <br>
      {{ section.settings.heading_part_2 }} <span class="text-cyan-400">{{ section.settings.heading_accent_2 }}</span>
    </h1>
    <p class="text-lg md:text-xl text-white/60 max-w-2xl mx-auto mb-10 font-medium">
      {{ section.settings.text }}
    </p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="{{ section.settings.button_link }}" class="w-full sm:w-auto bg-purple-600 hover:bg-purple-500 text-white font-bold px-10 py-5 rounded-full text-lg transition-all transform hover:scale-105 flex items-center justify-center gap-2">
        {{ section.settings.button_label }}
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Viral Hero",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Exclusive Drop" },
    { "type": "text", "id": "heading_part_1", "label": "Heading Part 1", "default": "Go" },
    { "type": "text", "id": "heading_accent", "label": "Heading Accent", "default": "Viral" },
    { "type": "text", "id": "heading_part_2", "label": "Heading Part 2", "default": "With Your" },
    { "type": "text", "id": "heading_accent_2", "label": "Heading Accent 2", "default": "Setup" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "The most aesthetic gear curated for creators." },
    { "type": "text", "id": "button_label", "label": "Button Label", "default": "Shop Now" },
    { "type": "url", "id": "button_link", "label": "Button Link" }
  ],
  "presets": [{ "name": "Viral Hero" }]
}
{% endschema %}
